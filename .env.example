# ─── Family Dentists — Налаштування (.env) ───────────────────
# Скопіюйте цей файл: cp .env.example .env
# Заповніть свої дані

# 1. Telegram Bot Token
#    Отримати: написати @BotFather у Telegram → /newbot
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# 2. Telegram ID адміністраторів (через кому, без пробілів)
#    Дізнатись свій ID: написати @userinfobot у Telegram
ADMIN_IDS=123456789,987654321

# 3. Пароль для веб-панелі (адмін-сайт)
ADMIN_PASSWORD=мій_пароль_123

# 4. Секретний ключ для сесій (будь-який рядок)
SECRET_KEY=dentist_secret_ключ_2024

# 5. Шлях до бази даних
DB_PATH=dentist.db
